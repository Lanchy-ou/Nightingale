{
	local_certs
	skip_install_trust
	http_port 8080
	https_port 8443
}

http://127.0.0.1:8080 {
	bind 127.0.0.1
	redir https://127.0.0.1:8443{uri} permanent
}

https://127.0.0.1:8443 {
	bind 127.0.0.1
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
		}
		root * ../frontend/dist
		try_files {path} /index.html
		file_server
	}
}
