# D5 single-machine synthetic-data product Demo. Copy values into the process
# environment or a local untracked .env file; never commit actual secrets.
NANTINGALE_ENV=production
NANTINGALE_DATABASE_MODE=sqlcipher
NANTINGALE_DB_PATH=E:/private/nantingale.encrypted.db
NANTINGALE_DB_KEY=<secret-manager-generated-32-plus-character-key>
NANTINGALE_BACKUP_KEY=<different-32-plus-character-backup-key>
NANTINGALE_RESTORED_DB_KEY=<rotated-32-plus-character-restore-key>
NANTINGALE_FRONTEND_ORIGIN=https://127.0.0.1:8443
NANTINGALE_SECURE_COOKIES=true
NANTINGALE_SECURITY_MODE=strict
NANTINGALE_DEMO_AUTH=false
NANTINGALE_TRUST_PROXY=true
NANTINGALE_AUTH_RATE_LIMIT=10
NANTINGALE_AUTH_RATE_WINDOW_SECONDS=60
NANTINGALE_MAX_REQUEST_BYTES=8388608
NANTINGALE_LLM_PROVIDER=mock
# E4 is fail-closed by default. Prepare the pinned local model first, then set
# the absolute ignored model directory and opt in for the synthetic Demo.
NANTINGALE_VOICE_ENABLED=false
NANTINGALE_ASR_PROVIDER=faster_whisper
NANTINGALE_ASR_MODEL_PATH=E:/private/models/faster-whisper-base
XDG_DATA_HOME=E:/private/nantingale-caddy-data
XDG_CONFIG_HOME=E:/private/nantingale-caddy-config
